NODE_ENV=development
PORT=3000

# PostgreSQL (create the database first: CREATE DATABASE contact_forms;)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_DATABASE=contact_forms
DATABASE_SCHEMA=public
DATABASE_SSL=false
DATABASE_LOGGING=false

# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Sandbox sender. Only delivers to the email that owns the Resend account
# until you verify your own domain.
EMAIL_FROM=Contact Form <onboarding@resend.dev>
# Optional: a real, monitored mailbox that receives replies.
# EMAIL_REPLY_TO=contact@yourdomain.com
# Brand shown in the subject, body and footer (defaults to Devsprosoft).
# EMAIL_BRAND_NAME=Devsprosoft

# Comma-separated list of allowed origins, or * for any
CORS_ORIGIN=*
